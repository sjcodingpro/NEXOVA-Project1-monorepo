# Copy this file to .env and fill in real values. .env itself must
# never be committed -- see the root .gitignore.
#
# A note on localhost vs. Docker service names:
#
# The general rule for this project is that services talk to each
# other by Docker service name (e.g. http://backend:8000), never
# localhost -- because from inside one container, "localhost" means
# that container, not its neighbor.
#
# The three URLs below are the deliberate exception, not an oversight.
# NEXT_PUBLIC_* variables are embedded into the JavaScript bundle that
# ships to the *browser* -- they're read by code running on your own
# machine, outside Docker's network entirely, where "backend" doesn't
# resolve to anything. The password-reset link built from FRONTEND_URL
# is the same situation: a real person clicks it in their email client,
# not another container. All three have to stay as the host-published
# ports (localhost:8000, localhost:3001) for exactly the reason the
# "use service names" rule exists in the first place -- using the
# wrong kind of address for who's actually making the request.
# (Nothing in this codebase currently makes a server-to-server call
# between the two containers -- every cross-service call here happens
# from the browser -- so in practice there's no URL in this file that
# should be a service name today. If a future server-side call is
# added, http://backend:8000 is what it should use.)

# --- Backend (FastAPI / services/api) ---------------------------------

# Supabase, Transaction pooler, URI type -- see services/api's own
# .env for the real value already in use.
DATABASE_URL=postgresql://postgres.xxxxx:yourpassword@aws-0-xxxxx.pooler.supabase.com:6543/postgres

JWT_SECRET_KEY=replace-with-a-long-random-string

RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Browser-facing on purpose -- see the note above. This is where the
# password-reset email's link points.
FRONTEND_URL=http://localhost:3001

ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGIN_REGEX=http://localhost:\d+

# --- UI (Next.js backoffice) -------------------------------------------

# Both browser-facing on purpose -- see the note above.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
