# Copy this file to .env and fill in real values. .env itself must
# never be committed -- see the root .gitignore.
#
# A note on localhost vs. Docker service names:
#
# The general rule for this project is that services talk to each
# other by Docker service name (e.g. http://backend:8000), never
# localhost -- because from inside one container, "localhost" means
# that container, not its neighbor.
#
# The three URLs below are the deliberate exception, not an oversight.
# NEXT_PUBLIC_* variables are embedded into the JavaScript bundle that
# ships to the *browser* -- they're read by code running on your own
# machine, outside Docker's network entirely, where "backend" doesn't
# resolve to anything. The password-reset link built from FRONTEND_URL
# is the same situation: a real person clicks it in their email client,
# not another container. All three have to stay as the host-published
# ports (localhost:8000, localhost:3001) for exactly the reason the
# "use service names" rule exists in the first place -- using the
# wrong kind of address for who's actually making the request.
# (Nothing in this codebase currently makes a server-to-server call
# between the two containers -- every cross-service call here happens
# from the browser -- so in practice there's no URL in this file that
# should be a service name today. If a future server-side call is
# added, http://backend:8000 is what it should use.)

# --- Backend (FastAPI / services/api) ---------------------------------

# Supabase, Transaction pooler, URI type -- see services/api's own
# .env for the real value already in use.
DATABASE_URL=postgresql://postgres.xxxxx:yourpassword@aws-0-xxxxx.pooler.supabase.com:6543/postgres

JWT_SECRET_KEY=replace-with-a-long-random-string

RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Browser-facing on purpose -- see the note above. This is where the
# password-reset email's link points.
FRONTEND_URL=http://localhost:3001

ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGIN_REGEX=http://localhost:\d+

# --- UI (Next.js backoffice) -------------------------------------------

# Both browser-facing on purpose -- see the note above.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# --- Telemetry (Phase 2 stub; swapped for the real endpoint in Phase 3) ---

# Backend: where telemetry batches are expected to land.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# UI: browser-facing on purpose (NEXT_PUBLIC_*, see the note above).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# --- RAG knowledge base (Milestone 7: data/process/rag.py, data/pipelines/rag.py) ---

# 4Geeks student LLM gateway (LiteLLM, OpenAI-compatible). Key: 4geeks.com profile ->
# LLM API Keys -> View details. Never commit the real key.
RAG_BASE_URL=https://llm.4geeks.ai/v1
RAG_API_KEY=
# Two DIFFERENT models: embeddings for setup()/retrieve(), chat for generate_answer().
# Exact ids as the gateway names them (no "litellm/" prefix shown on the 4Geeks page). List them:
#   uv run python -c "from data.pipelines.rag import _generation_client as c; print([m.id for m in c().models.list().data])"
RAG_EMBED_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
# (glm-5.3-flash is listed on the dashboard but the gateway rejects it.)
RAG_GEN_MODEL=downtown-miami/openrouter/deepseek/deepseek-v4-flash
# Only if embeddings are served from a different endpoint/key:
# RAG_EMBED_BASE_URL=
# RAG_EMBED_API_KEY=

# Local runs (uv run ...) reach Qdrant on the host port; docker-compose overrides this
# to http://qdrant:6333 for the backend container.
QDRANT_URL=http://localhost:6333
# Minimum cosine similarity for a chunk to be used (tuned in docs/rag/rag-design.md).
RAG_MIN_SCORE=0.30

# --- Support agent -> company-tools MCP server (client-credentials, scope incidents:read) ---
AGENT_MCP_URL=http://localhost:8010/mcp
AGENT_OAUTH_TOKEN_URL=https://YOUR-TENANT.us.auth0.com/oauth/token
AGENT_OAUTH_CLIENT_ID=
AGENT_OAUTH_CLIENT_SECRET=
AGENT_OAUTH_AUDIENCE=https://nexova-company-tools
