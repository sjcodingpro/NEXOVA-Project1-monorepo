# company-tools MCP server. Copy to .env (gitignored) and fill in. Never commit real values.

# --- OAuth (mcpauth, resource-server mode) ---
# Authorization server issuer, e.g. your Auth0 tenant (keep the trailing slash for Auth0).
MCP_AUTH_ISSUER=https://YOUR-TENANT.us.auth0.com/
# Audience = the Auth0 API identifier. Tokens for any other audience are rejected.
MCP_AUTH_AUDIENCE=https://nexova-company-tools
# Public URL of this MCP endpoint. In Codespaces: https://<codespace>-8010.app.github.dev/mcp
MCP_RESOURCE_URL=http://localhost:8010/mcp

# --- Company systems this server calls ---
INCIDENTS_API_URL=http://localhost:8000
# Service account the server uses to call the Incidents API (a normal user in db.json).
INCIDENTS_API_EMAIL=mcp-service@nexova.com
INCIDENTS_API_PASSWORD=
INVENTORY_API_URL=http://localhost:8000
COMPANY_API_TIMEOUT_S=5

# --- Logging / hosting ---
MCP_INVOCATION_LOG=logs/invocations.jsonl
# Codespaces forwards with its own Host header; leave false unless you list allowed hosts.
MCP_DNS_REBINDING_PROTECTION=false
